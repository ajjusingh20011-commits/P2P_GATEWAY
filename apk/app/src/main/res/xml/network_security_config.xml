<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (plain HTTP) traffic is blocked by default on Android 9+. This
  scopes an explicit exception to the ngo-backend VPS's IP ONLY — every other
  host the app talks to still requires HTTPS.

  TEMPORARY: the VPS is not yet fronted by TLS. Real device tokens and
  payment/SMS event bodies are sent unencrypted to this host. Replace with a
  real certificate (or a reverse proxy / tunnel that terminates TLS) before
  this is used with real production traffic, and remove this override.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">198.44.140.74</domain>
    </domain-config>
</network-security-config>
