PORT=3000
MONGODB_URL=mongodb+srv://...
JWT_SECRET=your_secret_here
ENCRYPTION_KEY=your_key_here
PROXY_USERNAME=
PROXY_PASSWORD=

# APK auto-update (GET /api/apk/latest-version) — bump these whenever a new
# build is uploaded to the existing /downloads/paymentbot.apk static path
# (nginx, not this process). Must match that build's app/build.gradle.kts
# versionCode/versionName exactly, or every device downloads a "newer"
# build that's actually identical (or worse, an older one).
APK_LATEST_VERSION_CODE=1
APK_LATEST_VERSION_NAME=1.0
APK_DOWNLOAD_URL=http://198.44.140.74/downloads/paymentbot.apk
